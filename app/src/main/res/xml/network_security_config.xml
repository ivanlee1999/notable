<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is blocked by default from API 28 on, and stays blocked here for every real
  server: sync authenticates with HTTP Basic, so plaintext to a host we cannot vouch for hands
  over the password.

  A self-hosted CouchDB on the LAN is the case that tempts an exception, and it cannot have one.
  A `domain` matches a hostname or an IP literal exactly — there is no CIDR syntax — so permitting
  "the local network" is not expressible, and permitting one address only helps whoever happens to
  use it. The alternative, cleartextTrafficPermitted on base-config, would also cover every host on
  the internet. So the answer for a LAN server is an https:// endpoint: a reverse proxy or a tunnel
  in front of CouchDB.

  A rejected address fails with UnknownServiceException, which the client reports as
  CouchError.Blocked — naming the scheme as the problem, rather than claiming the device is offline.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- Development only: loopback, and the host machine as seen from the emulator. Neither can
         leave the device or the developer's own machine, so neither exposes a password to a
         network. No `includeSubdomains` — these are exact hosts, and on an IP literal it means
         nothing anyway. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain>localhost</domain>
        <domain>127.0.0.1</domain>
        <domain>10.0.2.2</domain>
    </domain-config>
</network-security-config>
